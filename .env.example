# ── 服务配置 ──
APP_HOST=0.0.0.0
APP_PORT=8000
# FRONTEND_URL=http://localhost:3000

# ── SQLite 数据基础（部署配置，不由系统设置页面修改） ──
DATABASE_PATH=./data/app.db
DATABASE_BACKUP_DIR=./data/backups
STORAGE_AUTO_MIGRATE=true

# ── 仅限本地演示认证 ──
# 开启后成员自动激活，密码为企业邮箱 @ 前缀。正式部署必须为 false。
DEMO_SIMPLE_AUTH=false

# ── LLM 配置（二选一） ──
#
# 方式 A：OpenAI 兼容 API（推荐）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-ada-002
#
# 方式 B：本地离线嵌入（无需 API Key，自动 fallback）
# 将 OPENAI_API_KEY 留空，系统会自动使用 LOCAL_EMBEDDING_MODEL
# OPENAI_API_KEY=
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── 知识库配置 ──
PROJECT_NAME=默认项目
CHROMA_PERSIST_DIR=./chroma_db
MAX_UPLOAD_SIZE_MB=50
MAX_BATCH_UPLOAD_FILES=20
MAX_BATCH_UPLOAD_SIZE_MB=100
MAX_DOCUMENT_OCR_PAGES=100

# ── 检索参数（可选调优） ──
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# RETRIEVER_K=4
# RETRIEVER_SCORE_THRESHOLD=0.3

# ── 项目知识管理 ──
# ENABLE_KNOWLEDGE_GRAPH=true
# AUTO_CLASSIFY_DOCUMENTS=true

# ── 飞书集成（可选） ──
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_WEBHOOK_SECRET=
# FEISHU_BOT_NAME=AI 知识库助手
# FEISHU_DEFAULT_CHAT_ID=
# TASK_REMINDER_SCAN_SECONDS=60
# GOVERNANCE_SCAN_SECONDS=300

# ── HTTP 代理（可选） ──
# HTTP_PROXY_ENABLED=false
# HTTP_PROXY_URL=http://127.0.0.1:7890
# HTTP_VERIFY_SSL=true
